MYSQL_USER=
MYSQL_PASSWORD=

# Local Totara site (docker). TOTARA_URL is the site wwwroot.
TOTARA_URL=http://localhost:8080
TOTARA_WS_TOKEN=

# Production SSH + MySQL
PROD_SSH_HOST=
PROD_SSH_PORT=222
PROD_SSH_USER=
PROD_SSH_KEY_PATH=~/.ssh/id_ed25519
PROD_SSH_PASSWORD=

# MySQL host as seen from the SSH server (localhost if MySQL is on that box).
PROD_MYSQL_HOST=localhost
PROD_MYSQL_PORT=3306
PROD_MYSQL_USER=
PROD_MYSQL_PASSWORD=